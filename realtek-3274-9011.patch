 G_DEFINE_TYPE (FpiDeviceRealtek, fpi_device_realtek, FP_TYPE_DEVICE)
 
+/* 3274:9011 refuses access to the on-chip template store while "system 1"
+ * is selected: GET_TEMPLATE (0x45 0x0e) then answers with error status 0x01,
+ * which makes every enrollment fail with "Status check failed" (the template
+ * table cannot be read to locate a free slot).  Selecting system 0 instead
+ * keeps the store readable; the capture/verify command path is unaffected. */
+#define REALTEK_QUIRK_SELECT_OS_0 1
+
 static const FpIdEntry id_table[] = {
   { .vid = 0x0bda,  .pid = 0x5813,  },
   { .vid = 0x0bda,  .pid = 0x5816,  },
   { .vid = 0x2541,  .pid = 0xfa03,  },
   { .vid = 0x3274,  .pid = 0x9003,  },
+  { .vid = 0x3274,  .pid = 0x9011,  .driver_data = REALTEK_QUIRK_SELECT_OS_0 },
   { .vid = 0,  .pid = 0,  .driver_data = 0 },   /* terminating entry */
 };
 
@@ -170,8 +178,12 @@ fp_finish_capture_cb (FpiDeviceRealtek *self,
     }
   else
     {
-      fpi_ssm_jump_to_state (self->task_ssm,
-                             fpi_ssm_get_cur_state (self->task_ssm));
+      /* Poll for the finger.  Re-entering the state immediately would issue
+       * capture-status commands as fast as the USB stack allows (thousands
+       * per second), which needlessly hammers the sensor; pace it instead. */
+      fpi_ssm_jump_to_state_delayed (self->task_ssm,
+                                     fpi_ssm_get_cur_state (self->task_ssm),
+                                     FP_RTK_CAPTURE_POLL_MS);
     }
 }
 
