       break;
 
     case FP_RTK_INIT_SELECT_OS:
-      co_select_system.param[0] = 0x01;
+      if (fpi_device_get_driver_data (device) & REALTEK_QUIRK_SELECT_OS_0)
+        co_select_system.param[0] = 0x00;
+      else
+        co_select_system.param[0] = 0x01;
+
       cmd_buf = (guint8 *) &co_select_system;
       rtk_sensor_bulk_cmd (self, cmd_buf, NULL, FP_RTK_MSG_DEFAULT, 0, fp_task_ssm_generic_cb);
       break;
@@ -1268,12 +1279,10 @@ dev_probe (FpDevice *device)
       return;
     }
 
-  if (!g_usb_device_reset (usb_dev, &error))
-    {
-      g_usb_device_close (usb_dev, NULL);
-      fpi_device_probe_complete (device, NULL, NULL, error);
-      return;
-    }
+  /* Deliberately no reset here.  This sensor re-enumerates when reset, which
+   * leaves the GUsbDevice handle stale and made probing fail intermittently
+   * with "USB error ... Operation timed out".  Reading the descriptors needs
+   * no reset; dev_init() still resets before the sensor is used. */
 
   if (!g_usb_device_claim_interface (usb_dev, 0, 0, &error))
     {
@@ -1305,11 +1314,13 @@ dev_init (FpDevice *device)
   GError *error = NULL;
 
   G_DEBUG_HERE ();
-  if (!g_usb_device_reset (fpi_device_get_usb_device (device), &error))
-    {
-      fpi_device_open_complete (FP_DEVICE (self), error);
-      return;
-    }
+  /* NOTE: no g_usb_device_reset() here.
+   *
+   * This sensor re-enumerates when it is reset, which leaves the GUsbDevice
+   * handle stale; the following claim/commands then fail intermittently with
+   * "transfer timed out".  Opening the device without a reset was verified to
+   * be reliable, and the init sequence below (select system + read state)
+   * already puts the sensor into a known state, so the reset is not needed. */
 
   /* Claim usb interface */
   if (!g_usb_device_claim_interface (fpi_device_get_usb_device (device), 0, 0, &error))
